{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(npm run serve)",
      "Bash(npm run check:js)",
      "Bash(npm test)",
      "Bash(npm ci)",
      "Bash(node --check:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
